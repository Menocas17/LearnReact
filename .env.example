# --- Modo de autenticación ---
# "local": sin login, un único usuario local (solo funciona fuera de producción).
# "github": login con GitHub restringido a ALLOWED_EMAILS.
AUTH_MODE=local

# --- Base de datos ---
# Vacío: usa PGlite (Postgres embebido) en ./.data/pglite. Sin instalar nada.
# Con valor: cualquier Postgres (por ejemplo Neon). Ejecuta `pnpm db:migrate` antes.
DATABASE_URL=

# --- Better Auth (necesario con AUTH_MODE=github) ---
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Lista separada por comas de emails con acceso.
ALLOWED_EMAILS=

# Carpeta de PGlite (opcional). Los tests E2E usan una propia para no tocar tu progreso.
# PGLITE_DIR=.data/pglite
